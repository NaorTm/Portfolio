---
import BaseLayout from '../layouts/BaseLayout.astro';
import config from '../../portfolio.config.json';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const projects = [
  { number: '01', label: 'NETWORK SIMULATION', title: 'Block Propagation', description: 'Exploring how blocks travel through peer-to-peer networks, with comparisons across network topologies, latency and protocols.', tags: ['Python', 'P2P networks', 'Graph theory'], url: 'https://github.com/NaorTm/Block-Propagation-' },
  { number: '02', label: 'INTERACTIVE GEOGRAPHY GAME', title: 'Israel Geo Game', description: 'An interactive map quiz where players locate Israeli settlements, track personal bests and practise missed locations.', tags: ['React', 'TypeScript', 'Leaflet'], url: 'https://github.com/NaorTm/IsraelGeoGame', demo: 'https://naortm.github.io/IsraelGeoGame/', demoLabel: 'Play game' },
  { number: '03', label: 'SYSTEMS PROGRAMMING', title: 'MIPS Pipeline Simulator', description: 'A trace-driven C simulator that explores pipeline stages, hazards, forwarding and cycles per instruction.', tags: ['C', 'MIPS', 'Computer architecture'], url: 'https://github.com/NaorTm/MIPS-Comiper-' },
  { number: '04', label: 'DIGITAL DESIGN', title: 'FPGA Stopwatch', description: 'A dual-mode stopwatch implemented on an FPGA, with seconds, minutes and hundredths timing.', tags: ['VHDL', 'FPGA', 'Digital design'], url: 'https://github.com/NaorTm/FPGA-StopWatch', demo: 'https://www.youtube.com/watch?v=cVFWwiqZI68' },
];
---
<BaseLayout>
  <div class="portfolio">
    <header class="topbar">
      <a class="brand" href="#top" aria-label="Naor Tiram, back to top"><span class="brand-mark">NT<span>.</span></span><span class="brand-name">NAOR TIRAM<br/><small>ENGINEERING PORTFOLIO</small></span></a>
      <nav aria-label="Main navigation"><a href="#work">Work</a><a href="#about">About</a><a href="#contact">Contact</a></nav>
      <a class="header-link" href={`mailto:${config.social.email}`}>Let's talk <span>↗</span></a>
    </header>
    <section id="top" class="hero">
      <div class="hero-copy">
        <p class="eyebrow"><span class="status-dot"></span> SOFTWARE · ML · SYSTEMS</p>
        <h1>Building ideas<br/><em>into systems.</em></h1>
        <p class="hero-intro">Hi, I'm Naor Tiram. I bring an engineering mindset to software, machine learning and the systems that connect them.</p>
        <div class="actions"><a class="button button-primary" href="#work">Explore my work <span>↘</span></a><a class="button button-outline" href={`${base}/resume.pdf`} target="_blank" rel="noopener noreferrer">View résumé <span>↗</span></a></div>
      </div>
      <div class="hero-art" aria-hidden="true"><div class="art-grid"></div><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="orbit orbit-three"></div><div class="art-core"><span>NT</span><small>ENGINEER / BUILDER</small></div><span class="art-caption top-caption">SYSTEMS THINKING<br/>FROM IDEA TO IMPLEMENTATION</span><span class="art-caption bottom-caption">01 / EXPLORE<br/>02 / BUILD<br/>03 / REFINE</span><span class="art-cross cross-one">+</span><span class="art-cross cross-two">+</span></div>
      <div class="hero-bottom"><span>BASED IN HADERA, ISRAEL</span><span>SCROLL TO EXPLORE ↓</span></div>
    </section>
    <section class="evidence" aria-label="Background"><div><strong>MSc</strong><span>Electrical Engineering<br/>Technion</span></div><div><strong>BSc</strong><span>Computer Engineering<br/>Ruppin Academic Center</span></div><div><strong>01</strong><span>Machine Learning<br/>Hackathon winner</span></div></section>
    <section id="work" class="section work-section"><div class="section-heading"><div><p class="eyebrow">01 / SELECTED WORK</p><h2>Ideas made<br/><em>tangible.</em></h2></div><p>A selection of projects across software, networks and hardware. Each one reflects a different way of turning a technical problem into something you can explore.</p></div>
      <div class="projects">{projects.map((project) => <article class="project"><div class="project-index">{project.number} <span>↗</span></div><div class="project-content"><p class="project-label">{project.label}</p><h3>{project.title}</h3><p class="project-description">{project.description}</p><div class="tags">{project.tags.map(tag => <span>{tag}</span>)}</div></div><div class="project-links">{project.private ? <span>Private repository</span> : <a href={project.url} target="_blank" rel="noopener noreferrer" aria-label={`View ${project.title} on GitHub`}>View project <span>↗</span></a>}{project.demo && <a href={project.demo} target="_blank" rel="noopener noreferrer">{project.demoLabel ?? 'Watch demo'} <span>↗</span></a>}</div></article>)}</div>
      <a class="text-link" href={`https://github.com/${config.social.github}`} target="_blank" rel="noopener noreferrer">Explore more on GitHub <span>↗</span></a>
    </section>
    <section id="about" class="section about-section"><div class="section-heading"><div><p class="eyebrow">02 / ABOUT</p><h2>Curious by nature.<br/><em>Engineer by practice.</em></h2></div><div class="about-copy"><p>I'm an MSc Electrical Engineering student at the Technion with a BSc in Computer Engineering. My interests span machine learning, software and the underlying systems that make ideas work.</p><p>I enjoy working across levels of abstraction: from algorithms and simulations to APIs, interfaces and hardware.</p><a class="text-link" href={`${base}/resume.pdf`} target="_blank" rel="noopener noreferrer">More in my résumé <span>↗</span></a></div></div><div class="capabilities"><div><span>01</span><h3>Software & systems</h3><p>C, C++, Python, Java, JavaScript<br/>Algorithms · Data structures · Networking</p></div><div><span>02</span><h3>ML & simulation</h3><p>Machine learning · Artificial intelligence<br/>MATLAB · Network simulation</p></div><div><span>03</span><h3>Beyond the code</h3><p>Digital design · VHDL · FPGA<br/>Communication · Teamwork · Problem-solving</p></div></div></section>
    <section id="contact" class="contact-section"><div><p class="eyebrow">03 / GET IN TOUCH</p><h2>Let's build<br/><em>something useful.</em></h2><p>Have a role, project or idea in mind? I'd love to hear about it.</p><a class="contact-email" href={`mailto:${config.social.email}`}>{config.social.email} <span>↗</span></a></div><div class="contact-side"><span>FIND ME ELSEWHERE</span><a href={`https://github.com/${config.social.github}`} target="_blank" rel="noopener noreferrer">GitHub ↗</a><a href={`https://linkedin.com/in/${config.social.linkedin}`} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a><a href={`${base}/resume.pdf`} target="_blank" rel="noopener noreferrer">Résumé ↗</a></div></section>
  </div>
</BaseLayout>


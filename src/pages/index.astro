---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import FeaturedHighlights from "../components/FeaturedHighlights.astro";
import FeaturedProjects from "../components/FeaturedProjects.astro";
import SkillsGrid from "../components/SkillsGrid.astro";
import ResumeCTA from "../components/ResumeCTA.astro";
import Contact from "../components/Contact.astro";
import { getProjects } from "../lib/projects";

const { config, projects } = await getProjects();
const baseUrl = import.meta.env.BASE_URL ?? "/";
const normalizeBase = baseUrl.endsWith("/") ? baseUrl.slice(0, -1) : baseUrl;
const resumePath = config.resume.pdfPath.startsWith("/")
  ? `${normalizeBase}${config.resume.pdfPath}`
  : config.resume.pdfPath;
const avatarSrc = `${normalizeBase}/og-image.png`;
---
<BaseLayout>
  <Header theme={config.site.theme} />

  <!-- Summary / Homepage -->
  <section class="pt-28 pb-10 border-b border-ink/10">
    <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-8">
      <div class="space-y-4 max-w-lg">
        <div>
          <h1 class="font-display text-3xl font-bold tracking-tight">{config.profile.name}</h1>
          <p class="mt-1 text-sm text-muted">{config.profile.headline}</p>
        </div>
        <p class="text-ink/80 leading-relaxed">{config.profile.bio}</p>
        {config.profile.location && (
          <p class="flex items-center gap-1.5 text-sm text-muted">
            <svg class="h-3.5 w-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            {config.profile.location}
          </p>
        )}
        <div class="flex flex-wrap gap-5 pt-1">
          <a href={`https://github.com/${config.social.github}`} target="_blank" rel="noopener noreferrer" class="text-sm text-muted transition-colors hover:text-ink">GitHub</a>
          <a href={`https://linkedin.com/in/${config.social.linkedin}`} target="_blank" rel="noopener noreferrer" class="text-sm text-muted transition-colors hover:text-ink">LinkedIn</a>
          <a href={`mailto:${config.social.email}`} class="text-sm text-muted transition-colors hover:text-ink">{config.social.email}</a>
          <a href={resumePath} target="_blank" rel="noopener noreferrer" class="text-sm text-muted transition-colors hover:text-ink">Resume PDF</a>
        </div>
      </div>
      <img
        src={avatarSrc}
        alt={config.profile.name}
        class="h-24 w-24 shrink-0 self-start rounded-xl object-cover ring-1 ring-ink/10"
        loading="eager"
      />
    </div>
  </section>

  <!-- Tab navigation -->
  <div class="border-b border-ink/10">
    <nav class="flex" role="tablist">
      <button role="tab" data-tab="projects" aria-selected="true" aria-controls="tab-projects" class="tab-btn -mb-px border-b-2 border-ink px-5 py-3 text-sm font-medium text-ink transition-colors">Projects</button>
      <button role="tab" data-tab="skills" aria-selected="false" aria-controls="tab-skills" class="tab-btn -mb-px border-b-2 border-transparent px-5 py-3 text-sm font-medium text-muted transition-colors hover:text-ink">Skills</button>
      <button role="tab" data-tab="resume" aria-selected="false" aria-controls="tab-resume" class="tab-btn -mb-px border-b-2 border-transparent px-5 py-3 text-sm font-medium text-muted transition-colors hover:text-ink">Resume</button>
      <button role="tab" data-tab="contact" aria-selected="false" aria-controls="tab-contact" class="tab-btn -mb-px border-b-2 border-transparent px-5 py-3 text-sm font-medium text-muted transition-colors hover:text-ink">Contact</button>
    </nav>
  </div>

  <!-- Tab panels -->
  <div id="tab-projects" role="tabpanel" class="tab-panel">
    <FeaturedHighlights />
    <FeaturedProjects projects={projects} />
  </div>

  <div id="tab-skills" role="tabpanel" class="tab-panel hidden">
    <SkillsGrid skills={config.skills} />
  </div>

  <div id="tab-resume" role="tabpanel" class="tab-panel hidden">
    <ResumeCTA resume={config.resume} />
  </div>

  <div id="tab-contact" role="tabpanel" class="tab-panel hidden">
    <Contact social={config.social} contact={config.contact} />
  </div>
</BaseLayout>

<script>
  const tabBtns = document.querySelectorAll<HTMLButtonElement>(".tab-btn");
  const tabPanels = document.querySelectorAll<HTMLElement>(".tab-panel");
  const validTabs = ["projects", "skills", "resume", "contact"];

  function activateTab(id: string) {
    tabBtns.forEach((btn) => {
      const active = btn.dataset.tab === id;
      btn.setAttribute("aria-selected", active ? "true" : "false");
      btn.classList.toggle("border-ink", active);
      btn.classList.toggle("text-ink", active);
      btn.classList.toggle("border-transparent", !active);
      btn.classList.toggle("text-muted", !active);
    });
    tabPanels.forEach((panel) => {
      panel.classList.toggle("hidden", panel.id !== `tab-${id}`);
    });
    history.replaceState(null, "", `#${id}`);
  }

  tabBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      const tab = btn.dataset.tab;
      if (tab) activateTab(tab);
    });
  });

  const hash = window.location.hash.slice(1);
  if (validTabs.includes(hash)) {
    activateTab(hash);
  }
</script>

---
const { social, contact } = Astro.props;
---
<section id="contact" class="scroll-mt-24 py-20">
  <div class="relative overflow-hidden rounded-3xl border border-ink/10 bg-gradient-to-br from-paper via-paper to-accent/5 p-8 shadow-xl md:p-12">
    <!-- Decorative elements -->
    <div class="pointer-events-none absolute -right-20 -top-20 h-64 w-64 rounded-full bg-accent/10 blur-[80px]"></div>
    <div class="pointer-events-none absolute -bottom-20 -left-20 h-64 w-64 rounded-full bg-accent2/10 blur-[80px]"></div>
    
    <div class="relative max-w-2xl mx-auto text-center">
      <!-- Header -->
      <div class="space-y-4 mb-8">
        <div class="inline-flex items-center gap-2 rounded-full bg-accent/10 px-4 py-2 text-sm font-medium text-accent">
          <span class="relative flex h-2 w-2">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent opacity-75"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-accent"></span>
          </span>
          Available for hire
        </div>
        <h2 class="font-display text-4xl font-bold">Let's connect</h2>
        <p class="text-muted">
          Open to opportunities and collaborations. Reach out anytime!
        </p>
      </div>
      
      <!-- Social links -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href={`https://github.com/${social.github}`}
          target="_blank"
          rel="noopener noreferrer"
          class="group flex items-center gap-3 rounded-2xl border border-ink/10 bg-paper/50 px-6 py-4 transition-all hover:-translate-y-1 hover:border-ink/20 hover:shadow-lg"
        >
          <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-ink/5 transition-colors group-hover:bg-ink group-hover:text-paper">
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
          </div>
          <div class="text-left">
            <p class="font-semibold">GitHub</p>
            <p class="text-sm text-muted">@{social.github}</p>
          </div>
        </a>
        
        <a
          href={`https://linkedin.com/in/${social.linkedin}`}
          target="_blank"
          rel="noopener noreferrer"
          class="group flex items-center gap-3 rounded-2xl border border-ink/10 bg-paper/50 px-6 py-4 transition-all hover:-translate-y-1 hover:border-ink/20 hover:shadow-lg"
        >
          <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-ink/5 transition-colors group-hover:bg-[#0077b5] group-hover:text-paper">
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </div>
          <div class="text-left">
            <p class="font-semibold">LinkedIn</p>
            <p class="text-sm text-muted">/{social.linkedin}</p>
          </div>
        </a>
        
        <button
          id="copy-email"
          data-email={social.email}
          class="group flex items-center gap-3 rounded-2xl border border-ink/10 bg-paper/50 px-6 py-4 transition-all hover:-translate-y-1 hover:border-ink/20 hover:shadow-lg"
        >
          <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-ink/5 transition-colors group-hover:bg-accent group-hover:text-paper">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <div class="text-left">
            <p class="font-semibold">Email</p>
            <p id="copy-feedback" class="text-sm text-muted">{social.email}</p>
          </div>
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  const copyBtn = document.getElementById("copy-email");
  const feedback = document.getElementById("copy-feedback");
  
  copyBtn?.addEventListener("click", async () => {
    const email = copyBtn.getAttribute("data-email");
    if (email && feedback) {
      const originalText = feedback.textContent;
      await navigator.clipboard.writeText(email);
      feedback.textContent = "Copied!";
      feedback.classList.add("text-green-600");
      feedback.classList.remove("text-muted");
      
      setTimeout(() => {
        feedback.textContent = originalText;
        feedback.classList.remove("text-green-600");
        feedback.classList.add("text-muted");
      }, 2000);
    }
  });
</script>

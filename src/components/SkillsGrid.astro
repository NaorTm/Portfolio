---
const { skills } = Astro.props;
const entries = Object.entries(skills ?? {});

// Icons for each skill category
const categoryIcons = {
  Languages: `<svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" /></svg>`,
  "ML/AI": `<svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" /></svg>`,
  "CS Fundamentals": `<svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" /></svg>`,
  Systems: `<svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01" /></svg>`,
  "Soft Skills": `<svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" /></svg>`,
};

// Skill colors for visual interest
const skillColors = [
  "from-blue-500/20 to-blue-600/10",
  "from-purple-500/20 to-purple-600/10",
  "from-green-500/20 to-green-600/10",
  "from-orange-500/20 to-orange-600/10",
  "from-pink-500/20 to-pink-600/10",
];
---
<section id="skills" class="scroll-mt-24 py-20">
  <div class="space-y-4 text-center">
    <div class="inline-flex items-center gap-2 rounded-full bg-accent/10 px-4 py-2 text-sm font-medium text-accent">
      <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
      </svg>
      Technical Expertise
    </div>
    <h2 class="font-display text-4xl font-bold">Skills & Technologies</h2>
    <p class="mx-auto max-w-2xl text-muted">
      A comprehensive toolkit built through academic projects, certifications, and hands-on experience.
    </p>
  </div>
  
  <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
    {entries.map(([group, items], index) => (
      <div class="group relative overflow-hidden rounded-2xl border border-ink/10 bg-gradient-to-br from-paper to-paper/80 p-6 shadow-lg transition-all duration-300 hover:-translate-y-1 hover:shadow-xl">
        <!-- Gradient background on hover -->
        <div class={`absolute inset-0 bg-gradient-to-br ${skillColors[index % skillColors.length]} opacity-0 transition-opacity group-hover:opacity-100`}></div>
        
        <div class="relative">
          <div class="mb-4 flex items-center gap-3">
            <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-accent/10 text-accent transition-colors group-hover:bg-accent group-hover:text-paper">
              <Fragment set:html={categoryIcons[group] || categoryIcons.Languages} />
            </div>
            <h3 class="font-display text-lg font-bold">{group}</h3>
          </div>
          
          <div class="flex flex-wrap gap-2">
            {items.map((item, i) => (
              <span 
                class="inline-flex items-center gap-2 rounded-xl bg-ink/5 px-3 py-2 text-sm font-medium text-ink/80 transition-all hover:bg-ink/10 hover:scale-105"
                style={`animation-delay: ${i * 50}ms`}
              >
                <span class="h-1.5 w-1.5 rounded-full bg-accent"></span>
                {item}
              </span>
            ))}
          </div>
        </div>
      </div>
    ))}
  </div>
</section>

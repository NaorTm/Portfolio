---
const { resume } = Astro.props;
const baseUrl = import.meta.env.BASE_URL ?? "/";
const normalizeBase = baseUrl.endsWith("/") ? baseUrl.slice(0, -1) : baseUrl;
const resumePath = resume.pdfPath.startsWith("/")
  ? `${normalizeBase}${resume.pdfPath}`
  : resume.pdfPath;
---
<section id="resume" class="py-12">
  <div class="rounded-3xl border border-ink/10 bg-ink/95 p-8 text-paper shadow-glow">
    <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
      <div class="space-y-3">
        <p class="text-xs uppercase tracking-[0.3em] text-paper/60">Resume</p>
        <h2 class="font-display text-3xl font-semibold">Quick highlights</h2>
        <ul class="space-y-2 text-sm text-paper/80">
          {resume.highlights.map((item) => (
            <li class="flex items-start gap-3">
              <span class="mt-1 h-2 w-2 rounded-full bg-accent2"></span>
              {item}
            </li>
          ))}
        </ul>
      </div>
      <a
        href={resumePath}
        class="rounded-full bg-paper px-6 py-3 text-sm font-semibold text-ink transition hover:-translate-y-0.5"
      >
        Download Resume (PDF)
      </a>
    </div>
  </div>
</section>

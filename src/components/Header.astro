---
import ThemeToggle from "./ThemeToggle.astro";
import config from "../../portfolio.config.json";

const { theme } = Astro.props;
const navItems = [
  { href: "#about", label: "About" },
  { href: "#projects", label: "Projects" },
  { href: "#skills", label: "Skills" },
  { href: "#resume", label: "Resume" },
  { href: "#contact", label: "Contact" },
];
---
<header
  id="site-header"
  class="fixed left-0 right-0 top-0 z-50 transition-all duration-300"
>
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
    <a
      href="#"
      class="font-display text-lg font-semibold tracking-tight transition-colors hover:text-accent"
    >
      {config.profile.name.split(" ")[0]}
      <span class="text-accent">.</span>
    </a>
    <nav class="hidden items-center gap-1 md:flex">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="nav-link rounded-full px-4 py-2 text-sm font-medium text-ink/70 transition-all hover:bg-ink/5 hover:text-ink"
          data-section={item.href.slice(1)}
        >
          {item.label}
        </a>
      ))}
    </nav>
    <div class="flex items-center gap-4">
      <ThemeToggle enabled={theme?.allowToggle} />
      <button
        id="mobile-menu-btn"
        class="flex h-10 w-10 items-center justify-center rounded-full border border-ink/10 md:hidden"
        aria-label="Toggle menu"
      >
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>
  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="hidden border-t border-ink/10 bg-paper/95 backdrop-blur-lg md:hidden"
  >
    <nav class="flex flex-col px-6 py-4">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="mobile-nav-link rounded-lg px-4 py-3 text-sm font-medium text-ink/70 transition-colors hover:bg-ink/5 hover:text-ink"
          data-section={item.href.slice(1)}
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById("site-header");
  const mobileMenuBtn = document.getElementById("mobile-menu-btn");
  const mobileMenu = document.getElementById("mobile-menu");
  const navLinks = document.querySelectorAll(".nav-link, .mobile-nav-link");

  // Scroll effect for header
  let lastScroll = 0;
  window.addEventListener("scroll", () => {
    const currentScroll = window.scrollY;
    
    if (currentScroll > 50) {
      header?.classList.add("bg-paper/80", "backdrop-blur-lg", "shadow-sm", "border-b", "border-ink/5");
    } else {
      header?.classList.remove("bg-paper/80", "backdrop-blur-lg", "shadow-sm", "border-b", "border-ink/5");
    }
    
    lastScroll = currentScroll;
  });

  // Mobile menu toggle
  mobileMenuBtn?.addEventListener("click", () => {
    mobileMenu?.classList.toggle("hidden");
  });

  // Close mobile menu on link click
  document.querySelectorAll(".mobile-nav-link").forEach((link) => {
    link.addEventListener("click", () => {
      mobileMenu?.classList.add("hidden");
    });
  });

  // Active section highlighting
  const sections = document.querySelectorAll("section[id]");
  const observerOptions = {
    rootMargin: "-20% 0px -70% 0px",
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        const id = entry.target.getAttribute("id");
        navLinks.forEach((link) => {
          const section = link.getAttribute("data-section");
          if (section === id) {
            link.classList.add("text-accent", "bg-accent/10");
            link.classList.remove("text-ink/70");
          } else {
            link.classList.remove("text-accent", "bg-accent/10");
            link.classList.add("text-ink/70");
          }
        });
      }
    });
  }, observerOptions);

  sections.forEach((section) => observer.observe(section));
</script>

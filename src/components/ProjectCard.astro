---
const { project } = Astro.props;
const tags = [...(project.languages ?? []), ...(project.tags ?? [])].slice(0, 5);
const demoUrl = project.demoUrl && project.demoUrl.length > 0 ? project.demoUrl : null;
const baseUrl = import.meta.env.BASE_URL ?? "/";
const normalizeBase = baseUrl.endsWith("/") ? baseUrl.slice(0, -1) : baseUrl;
const withBase = (path) =>
  path.startsWith("/") ? `${normalizeBase}${path}` : path;
const thumbnailUrl = project.thumbnail ? withBase(project.thumbnail) : null;
const detailsUrl = withBase(`/projects/${project.slug}`);

// Language colors for visual badges
const langColors = {
  Python: "bg-[#3572A5]",
  JavaScript: "bg-[#f1e05a]",
  TypeScript: "bg-[#3178c6]",
  "C++": "bg-[#f34b7d]",
  C: "bg-[#555555]",
  Java: "bg-[#b07219]",
  MATLAB: "bg-[#e16737]",
  VHDL: "bg-[#adb2cb]",
  HTML: "bg-[#e34c26]",
  "C#": "bg-[#178600]",
};
const primaryLang = project.languages?.[0];
const langColor = langColors[primaryLang] ?? "bg-accent";
---
<article class="group relative flex h-full flex-col overflow-hidden rounded-2xl border border-ink/10 bg-gradient-to-br from-paper to-paper/80 shadow-lg transition-all duration-300 hover:-translate-y-2 hover:shadow-2xl">
  <!-- Accent glow on hover -->
  <div class="pointer-events-none absolute -inset-px rounded-2xl bg-gradient-to-r from-accent/50 via-accent2/50 to-accent/50 opacity-0 blur transition-opacity duration-300 group-hover:opacity-30"></div>
  
  <!-- Thumbnail -->
  <div class="relative h-44 overflow-hidden">
    {thumbnailUrl ? (
      <img
        src={thumbnailUrl}
        alt={`${project.name} preview`}
        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
        loading="lazy"
      />
    ) : (
      <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-ink/5 via-accent/5 to-accent2/5">
        <div class="flex flex-col items-center gap-3 text-muted">
          <svg class="h-12 w-12 opacity-40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
          </svg>
          <span class="text-xs font-medium uppercase tracking-widest opacity-60">Source Code</span>
        </div>
      </div>
    )}
    <!-- Language badge -->
    {primaryLang && (
      <div class="absolute left-4 top-4 flex items-center gap-2 rounded-full bg-paper/90 px-3 py-1.5 text-xs font-semibold shadow-md backdrop-blur-sm">
        <span class={`h-2.5 w-2.5 rounded-full ${langColor}`}></span>
        {primaryLang}
      </div>
    )}
    <!-- Gradient overlay -->
    <div class="absolute inset-0 bg-gradient-to-t from-paper via-transparent to-transparent"></div>
  </div>
  
  <!-- Content -->
  <div class="relative flex flex-1 flex-col gap-4 p-6">
    <div class="space-y-2">
      <h3 class="font-display text-xl font-bold leading-tight transition-colors group-hover:text-accent">
        {project.name}
      </h3>
      <p class="line-clamp-2 text-sm leading-relaxed text-muted">
        {project.description}
      </p>
    </div>
    
    <!-- Tags -->
    <div class="flex flex-wrap gap-2">
      {tags.slice(0, 4).map((tag) => (
        <span class="rounded-lg bg-ink/5 px-2.5 py-1 text-xs font-medium text-ink/70 transition-colors hover:bg-ink/10">
          {tag}
        </span>
      ))}
      {tags.length > 4 && (
        <span class="rounded-lg bg-ink/5 px-2.5 py-1 text-xs font-medium text-muted">
          +{tags.length - 4}
        </span>
      )}
    </div>
    
    <!-- Impact -->
    {project.impact ? (
      <p class="line-clamp-2 text-sm leading-relaxed text-ink/70">
        {project.impact}
      </p>
    ) : null}
    
    <!-- Stats -->
    <div class="mt-auto flex items-center gap-4 border-t border-ink/5 pt-4 text-xs text-muted">
      <span class="flex items-center gap-1.5">
        <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20">
          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
        </svg>
        {project.stars}
      </span>
      <span class="flex items-center gap-1.5">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
        </svg>
        {project.forks}
      </span>
      <span class="ml-auto flex items-center gap-1.5">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        {new Date(project.lastPushedAt).toLocaleDateString("en-US", { month: "short", year: "numeric" })}
      </span>
    </div>
    
    <!-- Action buttons -->
    <div class="flex gap-2 pt-2">
      <a
        href={project.htmlUrl}
        class="flex flex-1 items-center justify-center gap-2 rounded-xl border border-ink/15 py-2.5 text-sm font-semibold transition-all hover:border-ink hover:bg-ink/5"
      >
        <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
        </svg>
        Code
      </a>
      {demoUrl ? (
        <a
          href={demoUrl}
          class="flex flex-1 items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-accent to-accent2 py-2.5 text-sm font-semibold text-paper transition-all hover:-translate-y-0.5 hover:shadow-lg"
        >
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          Demo
        </a>
      ) : null}
      <a
        href={detailsUrl}
        class="flex items-center justify-center rounded-xl bg-ink/5 px-4 py-2.5 text-sm font-semibold transition-all hover:bg-ink/10"
      >
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </div>
</article>

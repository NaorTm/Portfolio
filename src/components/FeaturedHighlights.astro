---
// Featured work highlights - shown before the full projects grid
const highlights = [
  {
    title: "MIPS Compiler (C)",
    description: "C-like → MIPS assembly compiler with instruction parsing and trace generation",
    tags: ["C", "Compilers", "MIPS"],
    links: {
      demo: null,
      code: "https://github.com/NaorTm/MIPS-Comiper-",
      details: "/projects/mips-comiper-"
    },
    icon: `<svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" /></svg>`
  },
  {
    title: "Canon-ball Simulation",
    description: "Physics-based projectile trajectory simulation with visualization",
    tags: ["Python", "Physics", "Simulation"],
    links: {
      demo: null,
      code: "https://github.com/NaorTm/Canon-ball",
      details: "/projects/canon-ball"
    },
    icon: `<svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>`
  },
  {
    title: "Monopoly (C++)",
    description: "Full Monopoly game implementation with OOP design patterns",
    tags: ["C++", "OOP", "Game"],
    links: {
      demo: null,
      code: "https://github.com/NaorTm/Monopoly---Cplus",
      details: "/projects/monopoly---cplus"
    },
    icon: `<svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 10l-2 1m0 0l-2-1m2 1v2.5M20 7l-2 1m2-1l-2-1m2 1v2.5M14 4l-2-1-2 1M4 7l2-1M4 7l2 1M4 7v2.5M12 21l-2-1m2 1l2-1m-2 1v-2.5M6 18l-2-1v-2.5M18 18l2-1v-2.5" /></svg>`
  }
];

const baseUrl = import.meta.env.BASE_URL ?? "/";
const normalizeBase = baseUrl.endsWith("/") ? baseUrl.slice(0, -1) : baseUrl;
const withBase = (path) => path.startsWith("/") ? `${normalizeBase}${path}` : path;
---
<section class="py-16">
  <div class="mb-8 flex items-center gap-3">
    <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-accent to-accent2">
      <svg class="h-5 w-5 text-paper" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
      </svg>
    </div>
    <div>
      <h2 class="font-display text-2xl font-bold">Featured Work</h2>
      <p class="text-sm text-muted">Highlights from my portfolio</p>
    </div>
  </div>
  
  <div class="grid gap-6 md:grid-cols-3">
    {highlights.map((project) => (
      <div class="group relative overflow-hidden rounded-2xl border border-ink/10 bg-gradient-to-br from-paper to-paper/80 p-6 shadow-lg transition-all duration-300 hover:-translate-y-2 hover:shadow-xl">
        <!-- Gradient glow -->
        <div class="pointer-events-none absolute -inset-px rounded-2xl bg-gradient-to-r from-accent/40 via-accent2/40 to-accent/40 opacity-0 blur transition-opacity duration-300 group-hover:opacity-40"></div>
        
        <div class="relative space-y-4">
          <!-- Icon and title -->
          <div class="flex items-start gap-4">
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-accent/10 text-accent transition-colors group-hover:bg-accent group-hover:text-paper">
              <Fragment set:html={project.icon} />
            </div>
            <div>
              <h3 class="font-display text-lg font-bold leading-tight transition-colors group-hover:text-accent">
                {project.title}
              </h3>
              <p class="mt-1 text-sm text-muted">{project.description}</p>
            </div>
          </div>
          
          <!-- Tags -->
          <div class="flex flex-wrap gap-2">
            {project.tags.map((tag) => (
              <span class="rounded-lg bg-ink/5 px-2.5 py-1 text-xs font-medium text-ink/70">
                {tag}
              </span>
            ))}
          </div>
          
          <!-- Links -->
          <div class="flex gap-2 pt-2">
            <a
              href={project.links.code}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-1.5 rounded-lg bg-ink/5 px-3 py-2 text-xs font-semibold transition-colors hover:bg-ink/10"
            >
              <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
              </svg>
              Code
            </a>
            <a
              href={withBase(project.links.details)}
              class="flex items-center gap-1.5 rounded-lg bg-accent/10 px-3 py-2 text-xs font-semibold text-accent transition-colors hover:bg-accent/20"
            >
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              Details
            </a>
            {project.links.demo && (
              <a
                href={project.links.demo}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-1.5 rounded-lg bg-gradient-to-r from-accent to-accent2 px-3 py-2 text-xs font-semibold text-paper transition-all hover:-translate-y-0.5"
              >
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                Demo
              </a>
            )}
          </div>
        </div>
      </div>
    ))}
  </div>
  
  <!-- View All on GitHub -->
  <div class="mt-8 flex justify-center">
    <a
      href="https://github.com/NaorTm?tab=repositories"
      target="_blank"
      rel="noopener noreferrer"
      class="group inline-flex items-center gap-3 rounded-full border border-ink/20 bg-paper px-6 py-3 font-semibold transition-all hover:-translate-y-1 hover:border-ink/40 hover:shadow-lg"
    >
      <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
        <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
      </svg>
      View All on GitHub
      <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
      </svg>
    </a>
  </div>
</section>

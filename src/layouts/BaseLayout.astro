---
import config from "../../portfolio.config.json";
import "../styles/global.css";

const { title, description, ogImage } = config.site;
const pageTitle = Astro.props.title ? `${Astro.props.title} · ${title}` : title;
const pageDescription = Astro.props.description ?? description;
const canonical = new URL(Astro.url.pathname, config.site.url).toString();
const baseUrl = import.meta.env.BASE_URL ?? "/";
const normalizeBase = baseUrl.endsWith("/") ? baseUrl.slice(0, -1) : baseUrl;
const withBase = (path) =>
  path.startsWith("/") ? `${normalizeBase}${path}` : path;
const ogImageUrl = new URL(withBase(ogImage), config.site.url).toString();
const themeDefault = config.site.theme?.default ?? "dark";
const allowToggle = config.site.theme?.allowToggle ?? true;
---
<!doctype html>
<html
  lang="en"
  data-theme={themeDefault}
  data-default-theme={themeDefault}
  data-allow-toggle={allowToggle ? "true" : "false"}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="icon" href={withBase("/favicon.svg")} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;600;700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      const root = document.documentElement;
      const storedTheme = localStorage.getItem("theme");
      const allowToggle = root.dataset.allowToggle === "true";
      const defaultTheme = root.dataset.defaultTheme || "dark";
      const theme = storedTheme || defaultTheme;
      root.classList.toggle("dark", theme === "dark");
      root.dataset.theme = theme;
      if (!allowToggle) {
        localStorage.removeItem("theme");
      }
    </script>
  </head>
  <body class="relative overflow-x-hidden">
    <div class="pointer-events-none absolute inset-0 -z-10 opacity-80">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,_rgba(44,110,255,0.18),_transparent_60%)] dark:bg-[radial-gradient(circle_at_top,_rgba(133,168,255,0.2),_transparent_55%)]"></div>
      <div class="absolute -top-20 right-0 h-64 w-64 rounded-full bg-accent/10 blur-3xl"></div>
      <div class="absolute bottom-0 left-0 h-72 w-72 rounded-full bg-accent2/20 blur-3xl"></div>
      <div class="grain absolute inset-0"></div>
    </div>
    <main class="mx-auto w-full max-w-6xl px-6 pb-20 pt-10">
      <slot />
    </main>
  </body>
</html>
